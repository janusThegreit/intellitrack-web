{
	"info": {
		"_postman_id": "bpa-level-1-intellitrack-departments",
		"name": "IntelliTrack - BPA Level 1 Inter-Departmental HTTP APIs",
		"description": "Postman Collection for HTTP API integrations between IntelliTrack (CRM & Job Order System) and the 8 external departments based on BPA Level 1 Architecture.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "intellitrack_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "webhook_secret",
			"value": "intellitrack-bpa-secret-key-2026",
			"type": "string"
		},
		{
			"key": "crane_url",
			"value": "http://127.0.0.1:8011",
			"type": "string"
		},
		{
			"key": "manpower_url",
			"value": "http://127.0.0.1:8012",
			"type": "string"
		},
		{
			"key": "dispatch_url",
			"value": "http://127.0.0.1:8013",
			"type": "string"
		},
		{
			"key": "fleet_url",
			"value": "http://127.0.0.1:8014",
			"type": "string"
		},
		{
			"key": "ar_url",
			"value": "http://127.0.0.1:8015",
			"type": "string"
		},
		{
			"key": "billing_url",
			"value": "http://127.0.0.1:8016",
			"type": "string"
		},
		{
			"key": "contract_url",
			"value": "http://127.0.0.1:8017",
			"type": "string"
		},
		{
			"key": "asset_url",
			"value": "http://127.0.0.1:8018",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Crane and Equipment Management",
			"item": [
				{
					"name": "Outbound: Send Rental/Equipment Requirements to Crane Dept",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer token-crane-dept" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"job_order_number\": \"JO-20260924-AB12CD\",\n  \"customer_name\": \"Megaworld Construction\",\n  \"site_location\": \"BGC Taguig Site 4\",\n  \"requirements\": [\n    {\n      \"category\": \"Tower Crane\",\n      \"model\": \"Zoomlion TC7035\",\n      \"capacity\": \"16 Tons\",\n      \"quantity\": 1\n    }\n  ],\n  \"scheduled_date\": \"2026-10-01T08:00:00Z\",\n  \"due_date\": \"2026-12-31T17:00:00Z\"\n}"
						},
						"url": {
							"raw": "{{crane_url}}/api/v1/equipment-requests",
							"host": ["{{crane_url}}"],
							"path": ["api", "v1", "equipment-requests"]
						}
					}
				},
				{
					"name": "Inbound Webhook: Crane Dept Updates Equipment Status",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Department-Key", "value": "{{webhook_secret}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"job_order_number\": \"JO-20260924-AB12CD\",\n  \"equipment_code\": \"CRN-TC-004\",\n  \"status\": \"rented\",\n  \"inspection_passed\": true,\n  \"pemea_safety_cert_no\": \"DOLE-NCR-2026-8812\",\n  \"notes\": \"Load test passed at 16.5 metric tons. Safe for full site mobilization.\"\n}"
						},
						"url": {
							"raw": "{{intellitrack_url}}/api/v1/integrations/crane/status-update",
							"host": ["{{intellitrack_url}}"],
							"path": ["api", "v1", "integrations", "crane", "status-update"]
						}
					}
				}
			]
		},
		{
			"name": "2. Assign Driver/Operator and Equipment",
			"item": [
				{
					"name": "Outbound: Request Certified Operator & Riggers",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer token-manpower-dept" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"job_order_number\": \"JO-20260924-AB12CD\",\n  \"site_location\": \"BGC Taguig Site 4\",\n  \"start_date\": \"2026-10-01T08:00:00Z\",\n  \"crew_requirements\": [\n    {\n      \"role\": \"Tower Crane Operator\",\n      \"count\": 1,\n      \"certifications\": [\"TESDA NC II Tower Crane\"]\n    },\n    {\n      \"role\": \"Certified Rigger\",\n      \"count\": 2,\n      \"certifications\": [\"Rigging & Slinging NC I\"]\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{manpower_url}}/api/v1/operator-requests",
							"host": ["{{manpower_url}}"],
							"path": ["api", "v1", "operator-requests"]
						}
					}
				},
				{
					"name": "Inbound Webhook: Manpower Dept Submits Assigned Crew",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Department-Key", "value": "{{webhook_secret}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"job_order_number\": \"JO-20260924-AB12CD\",\n  \"assigned_crew\": [\n    {\n      \"role\": \"Tower Crane Operator\",\n      \"full_name\": \"Juan Dela Cruz\",\n      \"mobile\": \"+639171234567\",\n      \"employee_id\": \"EMP-1049\"\n    },\n    {\n      \"role\": \"Rigger\",\n      \"full_name\": \"Mario Santos\",\n      \"mobile\": \"+639189876543\",\n      \"employee_id\": \"EMP-2081\"\n    }\n  ],\n  \"assignment_status\": \"confirmed\"\n}"
						},
						"url": {
							"raw": "{{intellitrack_url}}/api/v1/integrations/manpower/assignment",
							"host": ["{{intellitrack_url}}"],
							"path": ["api", "v1", "integrations", "manpower", "assignment"]
						}
					}
				}
			]
		},
		{
			"name": "3. Dispatch Job and Scheduling",
			"item": [
				{
					"name": "Outbound: Send Job Order Information to Dispatch",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer token-dispatch-dept" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"job_order_number\": \"JO-20260924-AB12CD\",\n  \"customer\": {\n    \"name\": \"Megaworld Construction\",\n    \"phone\": \"+639170001122\"\n  },\n  \"destination_site\": {\n    \"address\": \"Skyline Tower, 7th Ave BGC Taguig\",\n    \"scheduled_date\": \"2026-10-01T06:00:00Z\"\n  },\n  \"items\": [\n    { \"equipment_name\": \"Zoomlion TC7035\", \"quantity\": 1 }\n  ]\n}"
						},
						"url": {
							"raw": "{{dispatch_url}}/api/v1/dispatches",
							"host": ["{{dispatch_url}}"],
							"path": ["api", "v1", "dispatches"]
						}
					}
				},
				{
					"name": "Inbound Webhook: Dispatch Dept Updates Dispatch Status",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Department-Key", "value": "{{webhook_secret}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"job_order_number\": \"JO-20260924-AB12CD\",\n  \"status\": \"arrived_on_site\",\n  \"remarks\": \"Cranes and trailers staged on designated pad. Rigging underway.\",\n  \"arrived_at\": \"2026-10-01T07:15:00Z\",\n  \"live_tracking_url\": \"https://dispatch.local/track/DSP-9912\"\n}"
						},
						"url": {
							"raw": "{{intellitrack_url}}/api/v1/integrations/dispatch/status",
							"host": ["{{intellitrack_url}}"],
							"path": ["api", "v1", "integrations", "dispatch", "status"]
						}
					}
				}
			]
		},
