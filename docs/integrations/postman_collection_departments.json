							"raw": "{\n  \"job_order_number\": \"JO-20260924-AB12CD\",\n  \"customer\": {\n    \"name\": \"Megaworld Construction\",\n    \"tin\": \"123-456-789-000\",\n    \"credit_terms\": \"30 Days\"\n  },\n  \"total_amount\": 450000.00,\n  \"currency\": \"PHP\",\n  \"verification_required\": true\n}"
