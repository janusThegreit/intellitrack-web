# -------------------------------------------------------------
# IntelliTrack Microservices Architecture Environment Settings
# -------------------------------------------------------------

APP_NAME="IntelliTrack Microservices"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Inter-Service Security Secret
MICROSERVICE_INTERNAL_SECRET=intellitrack-secret-token-prod

# API Gateway & Downstream Services URLs
GATEWAY_PORT=8000
AUTH_SERVICE_URL=http://127.0.0.1:8001
CUSTOMER_SERVICE_URL=http://127.0.0.1:8002
INVENTORY_SERVICE_URL=http://127.0.0.1:8003
QUOTATION_SERVICE_URL=http://127.0.0.1:8004
RENTAL_SERVICE_URL=http://127.0.0.1:8005
PROJECT_SERVICE_URL=http://127.0.0.1:8006
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8007
ANALYTICS_SERVICE_URL=http://127.0.0.1:8008

# Distributed Event Bus & Cache (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Database per Service Definitions
AUTH_DB_DATABASE=intellitrack_auth_db
CUSTOMER_DB_DATABASE=intellitrack_customer_db
INVENTORY_DB_DATABASE=intellitrack_inventory_db
QUOTATION_DB_DATABASE=intellitrack_quotation_db
RENTAL_DB_DATABASE=intellitrack_rental_db
PROJECT_DB_DATABASE=intellitrack_project_db
NOTIFICATION_DB_DATABASE=intellitrack_notification_db
ANALYTICS_DB_DATABASE=intellitrack_analytics_db

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=intellitrack_user
DB_PASSWORD=intellitrack_password
